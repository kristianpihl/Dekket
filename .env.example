# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings → API in the Supabase dashboard).
# .env is gitignored — never commit real keys.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (NO "VITE_" prefix, so it never reaches the browser) -----------------
# Needed for the document analysis (api/analyze.js). Create a key at https://platform.claude.com
# (Settings → API keys). Also add it in Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Optional:
# ANALYSIS_MODEL=claude-opus-5-5     # cheaper alternative: claude-sonnet-5-5
# ANALYSIS_EFFORT=medium             # low | medium | high
# ANALYSIS_DAILY_LIMIT=20            # analyses per user per 24 hours

# --- E-mail reminders (api/send-reminders.js, runs daily via Vercel cron) ---------------------
# All of these are SERVER-side only. Add them in Vercel → Settings → Environment Variables.
# CRON_SECRET=                    # any long random string; Vercel sends it with each scheduled call
# SUPABASE_SERVICE_ROLE_KEY=      # Supabase → Project Settings → API → service_role. VERY powerful: never share it
# RESEND_API_KEY=                 # from resend.com
# RESEND_FROM=Dekket <paaminnelser@dittdomene.no>   # the domain must be verified in Resend
# APP_URL=https://dekket.vercel.app
